# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 游戏数据：构建/开发前从上游 cmyyx/cep 拉取（scripts/sync-upstream-data.mjs），不入库
/data/weapons.ts
/data/equips.ts
/data/dungeons.ts

# 游戏图标：不随仓库分发，运行时经 jsDelivr（Fastly）镜像加载（lib/asset-urls.ts）
/public/images/weapon/
/public/images/equip/
/public/images/items/
